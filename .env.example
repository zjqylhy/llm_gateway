# 本地离线启动只需可选 GW_ADMIN_PASSWORD；凭据不要提交 Git。
GW_ADMIN_PASSWORD=
GW_ADMIN_USER=admin
# 生产必须设置：随机 32 字节的 base64，加密主密钥不可随意变更。
GW_MASTER_KEY=
GW_MYSQL_DSN=gateway:REPLACE@tcp(mysql:3306)/gateway?parseTime=true&loc=UTC
GW_REDIS_URL=redis://redis:6379/0
GW_KAFKA_BROKERS=kafka:9092
GW_KAFKA_TOPIC=gateway-events
GW_KAFKA_TLS=false
GW_KAFKA_USER=
GW_KAFKA_PASSWORD=
GW_ETCD_ENDPOINTS=http://etcd:2379
GW_ETCD_USER=
GW_ETCD_PASSWORD=
GW_MILVUS_URL=http://milvus:19530
GW_MILVUS_TOKEN=
GW_MILVUS_COLLECTION=gateway_cache
GW_CACHE_DIMENSIONS=1536
GW_ADMIN_ORIGIN=https://localhost:8443
OTEL_EXPORTER_OTLP_ENDPOINT=
# 仅 deploy/compose 联调使用，线上改用外部托管服务及 TLS。
GW_LOCAL_DB_PASSWORD=
GW_LOCAL_ROOT_PASSWORD=
GW_LOCAL_REDIS_PASSWORD=
GW_LOCAL_OBJECT_PASSWORD=
GW_GRAFANA_PASSWORD=
# 可选构建参数：Docker Hub 认证服务不可达时使用 Docker 官方的 AWS 公共仓库。
# GW_BUILD_NODE_IMAGE=public.ecr.aws/docker/library/node:24.21.0-bookworm-slim
# GW_BUILD_GO_IMAGE=public.ecr.aws/docker/library/golang:1.27.1-bookworm
# GW_BUILD_GOPROXY=https://goproxy.cn,direct

{
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": [
    "llm-gateway"
  ],
  "version": 2,
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "请求 QPS：全量与流式",
      "description": "每个已结束客户端请求一次；包括准入拒绝，不把模型重试重复计为请求。unknown 表示尚未解析正文。进程崩溃可能丢失结束指标，需结合客户端负载结果。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by(app,source,api,stream,outcome,http_status,error_code) (rate(gateway_api_calls_total{app=~\"$app\",instance=~\"$instance\",api=~\"$api\",stream=~\"$stream\",job=~\"gateway|admin\"}[$__rate_interval])))",
          "legendFormat": "全量请求"
        },
        {
          "refId": "B",
          "expr": "sum(max by(app,source,api,stream,outcome,http_status,error_code) (rate(gateway_api_calls_total{app=~\"$app\",instance=~\"$instance\",api=~\"$api\",stream=~\"$stream\",job=~\"gateway|admin\",stream=\"false\"}[$__rate_interval])))",
          "legendFormat": "非流式"
        },
        {
          "refId": "C",
          "expr": "sum(max by(app,source,api,stream,outcome,http_status,error_code) (rate(gateway_api_calls_total{app=~\"$app\",instance=~\"$instance\",api=~\"$api\",stream=~\"$stream\",job=~\"gateway|admin\",stream=\"true\"}[$__rate_interval])))",
          "legendFormat": "流式"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "N/A",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "请求成功率",
      "description": "保护性拒绝仍属于全量分母；SSE 业务错误按实际结束结果计失败。模型筛选不改变请求分母。无流量显示 N/A。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(max by(app,source,api,stream,outcome,http_status,error_code) (rate(gateway_api_calls_total{app=~\"$app\",instance=~\"$instance\",api=~\"$api\",stream=~\"$stream\",job=~\"gateway|admin\",outcome=\"success\"}[$__rate_interval]))) or vector(0))/sum(max by(app,source,api,stream,outcome,http_status,error_code) (rate(gateway_api_calls_total{app=~\"$app\",instance=~\"$instance\",api=~\"$api\",stream=~\"$stream\",job=~\"gateway|admin\"}[$__rate_interval])))",
          "legendFormat": "成功 / 全量"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "N/A",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Token 消耗 / 秒：输入、输出、总量",
      "description": "实际 attempt 用量；重试、embedding 独立计入。estimated 与 reported 分开；cached_input 是 input 子集，不再叠加到总量。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(kind,quality) (rate(gateway_tokens_total{app=~\"$app\",model=~\"$model\",instance=~\"$instance\",kind=~\"input|output\"}[$__rate_interval]))",
          "legendFormat": "{{kind}} / {{quality}}"
        },
        {
          "refId": "B",
          "expr": "sum by(quality) (rate(gateway_tokens_total{app=~\"$app\",model=~\"$model\",instance=~\"$instance\",kind=~\"input|output\"}[$__rate_interval]))",
          "legendFormat": "总量 / {{quality}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "N/A",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "请求平均 RT / ms",
      "description": "包含缓存命中、流式完整响应及早期拒绝；按实例/应用/API/流式筛选。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(gateway_api_seconds_sum{app=~\"$app\",instance=~\"$instance\",api=~\"$api\",stream=~\"$stream\",job=~\"gateway|admin\"}[$__rate_interval]))/(sum(rate(gateway_api_seconds_count{app=~\"$app\",instance=~\"$instance\",api=~\"$api\",stream=~\"$stream\",job=~\"gateway|admin\"}[$__rate_interval])))*1000",
          "legendFormat": "整体请求"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "noValue": "N/A",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "缓存命中与失败 / 秒",
      "description": "缓存当前为全局指标，不支持应用/API/模型筛选。缓存禁用时显示 N/A。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(result) (rate(gateway_cache_operations_total[$__rate_interval]))",
          "legendFormat": "{{result}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "N/A",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "限流与保护性拒绝 / 秒",
      "description": "限流、预算、实例过载和计量保护分开；不能把拒绝率当作上游执行故障率。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by(app,source,api,stream,outcome,http_status,error_code) (rate(gateway_api_calls_total{app=~\"$app\",instance=~\"$instance\",api=~\"$api\",stream=~\"$stream\",job=~\"gateway|admin\",outcome=\"error\",error_code=~\"insufficient_quota|app_qps_exceeded|gateway_overloaded|governance_unavailable|metering_unavailable\"}[$__rate_interval])))",
          "legendFormat": "保护性拒绝"
        },
        {
          "refId": "B",
          "expr": "sum by(error_code) (max by(app,source,api,stream,outcome,http_status,error_code) (rate(gateway_api_calls_total{app=~\"$app\",instance=~\"$instance\",api=~\"$api\",stream=~\"$stream\",job=~\"gateway|admin\",error_code=~\"insufficient_quota|app_qps_exceeded|gateway_overloaded|governance_unavailable|metering_unavailable\"}[$__rate_interval])))",
          "legendFormat": "{{error_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "N/A",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "请求 P95 / P99 RT",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le)(rate(gateway_api_seconds_bucket{app=~\"$app\",instance=~\"$instance\",api=~\"$api\",stream=~\"$stream\",job=~\"gateway|admin\"}[$__rate_interval])))*1000",
          "legendFormat": "0.95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99,sum by(le)(rate(gateway_api_seconds_bucket{app=~\"$app\",instance=~\"$instance\",api=~\"$api\",stream=~\"$stream\",job=~\"gateway|admin\"}[$__rate_interval])))*1000",
          "legendFormat": "0.99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "noValue": "N/A",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "保护性拒绝率与执行故障率",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(max by(app,source,api,stream,outcome,http_status,error_code) (rate(gateway_api_calls_total{app=~\"$app\",instance=~\"$instance\",api=~\"$api\",stream=~\"$stream\",job=~\"gateway|admin\",outcome=\"error\",error_code=~\"insufficient_quota|app_qps_exceeded|gateway_overloaded|governance_unavailable|metering_unavailable\"}[$__rate_interval]))) or vector(0))/sum(max by(app,source,api,stream,outcome,http_status,error_code) (rate(gateway_api_calls_total{app=~\"$app\",instance=~\"$instance\",api=~\"$api\",stream=~\"$stream\",job=~\"gateway|admin\"}[$__rate_interval])))",
          "legendFormat": "保护性拒绝 / 全量"
        },
        {
          "refId": "B",
          "expr": "(sum(max by(app,source,api,stream,outcome,http_status,error_code) (rate(gateway_api_calls_total{app=~\"$app\",instance=~\"$instance\",api=~\"$api\",stream=~\"$stream\",job=~\"gateway|admin\",outcome=\"error\",error_code!~\"insufficient_quota|app_qps_exceeded|gateway_overloaded|governance_unavailable|metering_unavailable\"}[$__rate_interval]))) or vector(0))/sum(max by(app,source,api,stream,outcome,http_status,error_code) (rate(gateway_api_calls_total{app=~\"$app\",instance=~\"$instance\",api=~\"$api\",stream=~\"$stream\",job=~\"gateway|admin\"}[$__rate_interval])))",
          "legendFormat": "其他失败 / 全量（含鉴权、输入与执行错误）"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "N/A",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "模型 attempt：成功与失败 / 秒",
      "description": "实际付费尝试分母；不包含 prepared 取消，不等于客户端请求成功率。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(model,status,quality)(rate(gateway_attempts_total{app=~\"$app\",model=~\"$model\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{model}} / {{status}} / {{quality}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "N/A",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "首 Token P95 / P99",
      "description": "从 attempt 开始到首次转发，包含准入开销；未转发事件无样本。模型指标不支持 API 筛选。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le,model)(rate(gateway_first_token_seconds_bucket{app=~\"$app\",model=~\"$model\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "{{model}} / 0.95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99,sum by(le,model)(rate(gateway_first_token_seconds_bucket{app=~\"$app\",model=~\"$model\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "{{model}} / 0.99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "N/A",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "网关自身开销 P95 / P99",
      "description": "attempt 总时间减上游读取/转发时间，含计量 ACK；当前按 purpose 与实例统计。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le,purpose)(rate(gateway_overhead_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "{{purpose}} / 0.95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99,sum by(le,purpose)(rate(gateway_overhead_seconds_bucket{instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "{{purpose}} / 0.99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "N/A",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {

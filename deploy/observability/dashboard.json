        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(state)(gateway_metering_attempt_records{job=\"worker\"})",
          "legendFormat": "{{state}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12

{
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": [
    "llm-gateway"
  ],
  "version": 1,
  "panels": [
    {
      "id": 101,
      "type": "timeseries",
      "title": "各应用请求 QPS",
      "description": "应用名称取当前配置，历史名称无映射时保留稳定 ID。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum by(app) (max by(app,source,api,stream,outcome,http_status,error_code) (rate(gateway_api_calls_total{app=~\"$app\",instance=~\"$instance\",api=~\"$api\",stream=~\"$stream\",job=~\"gateway|admin\"}[$__rate_interval])))) * on(app) group_left(app_name) topk by(app) (1, max by(app,app_name) (gateway_app_info{app=~\"$app\",job=~\"gateway|admin\"}))) or on(app) label_replace((sum by(app) (max by(app,source,api,stream,outcome,http_status,error_code) (rate(gateway_api_calls_total{app=~\"$app\",instance=~\"$instance\",api=~\"$api\",stream=~\"$stream\",job=~\"gateway|admin\"}[$__rate_interval])))),\"app_name\",\"$1\",\"app\",\"(.+)\")",
          "legendFormat": "{{app_name}} ({{app}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "N/A",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 102,
      "type": "timeseries",
      "title": "各应用成功率",
      "description": "分母包含所有请求及保护性拒绝，不受错误码筛选影响。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(((sum by(app) (max by(app,source,api,stream,outcome,http_status,error_code) (rate(gateway_api_calls_total{app=~\"$app\",instance=~\"$instance\",api=~\"$api\",stream=~\"$stream\",job=~\"gateway|admin\",outcome=\"success\"}[$__rate_interval]))) or on(app) (0 * sum by(app) (max by(app,source,api,stream,outcome,http_status,error_code) (rate(gateway_api_calls_total{app=~\"$app\",instance=~\"$instance\",api=~\"$api\",stream=~\"$stream\",job=~\"gateway|admin\"}[$__rate_interval]))))) / sum by(app) (max by(app,source,api,stream,outcome,http_status,error_code) (rate(gateway_api_calls_total{app=~\"$app\",instance=~\"$instance\",api=~\"$api\",stream=~\"$stream\",job=~\"gateway|admin\"}[$__rate_interval])))) * on(app) group_left(app_name) topk by(app) (1, max by(app,app_name) (gateway_app_info{app=~\"$app\",job=~\"gateway|admin\"}))) or on(app) label_replace(((sum by(app) (max by(app,source,api,stream,outcome,http_status,error_code) (rate(gateway_api_calls_total{app=~\"$app\",instance=~\"$instance\",api=~\"$api\",stream=~\"$stream\",job=~\"gateway|admin\",outcome=\"success\"}[$__rate_interval]))) or on(app) (0 * sum by(app) (max by(app,source,api,stream,outcome,http_status,error_code) (rate(gateway_api_calls_total{app=~\"$app\",instance=~\"$instance\",api=~\"$api\",stream=~\"$stream\",job=~\"gateway|admin\"}[$__rate_interval]))))) / sum by(app) (max by(app,source,api,stream,outcome,http_status,error_code) (rate(gateway_api_calls_total{app=~\"$app\",instance=~\"$instance\",api=~\"$api\",stream=~\"$stream\",job=~\"gateway|admin\"}[$__rate_interval])))),\"app_name\",\"$1\",\"app\",\"(.+)\")",
          "legendFormat": "{{app_name}} ({{app}})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "N/A",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 103,
      "type": "timeseries",
      "title": "错误 QPS：应用与错误码",
      "description": "SSE 已返回 HTTP 200 后发生的业务错误仍计入；只采用网关固定错误码。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum by(app,error_code,http_status) (max by(app,source,api,stream,outcome,http_status,error_code) (rate(gateway_api_calls_total{app=~\"$app\",instance=~\"$instance\",api=~\"$api\",stream=~\"$stream\",job=~\"gateway|admin\",outcome=\"error\",error_code=~\"$error_code\"}[$__rate_interval])))) * on(app) group_left(app_name) topk by(app) (1, max by(app,app_name) (gateway_app_info{app=~\"$app\",job=~\"gateway|admin\"}))) or on(app,error_code,http_status) label_replace((sum by(app,error_code,http_status) (max by(app,source,api,stream,outcome,http_status,error_code) (rate(gateway_api_calls_total{app=~\"$app\",instance=~\"$instance\",api=~\"$api\",stream=~\"$stream\",job=~\"gateway|admin\",outcome=\"error\",error_code=~\"$error_code\"}[$__rate_interval])))),\"app_name\",\"$1\",\"app\",\"(.+)\")",
          "legendFormat": "{{app_name}} ({{app}}) · {{error_code}} · HTTP {{http_status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "N/A",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 104,
      "type": "timeseries",
      "title": "Token / 秒：各应用",
      "description": "按 attempt 采样；reported 与 estimated 分开，不随错误码筛选变化。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "((sum by(app,kind,quality) (rate(gateway_tokens_total{app=~\"$app\",model=~\"$model\",job=~\"gateway|admin\"}[$__rate_interval]))) * on(app) group_left(app_name) topk by(app) (1, max by(app,app_name) (gateway_app_info{app=~\"$app\",job=~\"gateway|admin\"}))) or on(app,kind,quality) label_replace((sum by(app,kind,quality) (rate(gateway_tokens_total{app=~\"$app\",model=~\"$model\",job=~\"gateway|admin\"}[$__rate_interval]))),\"app_name\",\"$1\",\"app\",\"(.+)\")",
          "legendFormat": "{{app_name}} ({{app}}) · {{kind}} · {{quality}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "tps",
          "noValue": "N/A",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 105,
      "type": "timeseries",
      "title": "HTTP 状态码 QPS",
      "description": "HTTP 状态不等同业务结果；SSE 错误可能为 200。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(http_status) (max by(app,source,api,stream,outcome,http_status,error_code) (rate(gateway_api_calls_total{app=~\"$app\",instance=~\"$instance\",api=~\"$api\",stream=~\"$stream\",job=~\"gateway|admin\"}[$__rate_interval])))",
          "legendFormat": "HTTP {{http_status}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "N/A",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 1,
      "type": "timeseries",
      "title": "请求 QPS：全量与流式",
      "description": "每个已结束客户端请求一次；包括准入拒绝，不把模型重试重复计为请求。unknown 表示尚未解析正文。进程崩溃可能丢失结束指标，需结合客户端负载结果。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(max by(app,source,api,stream,outcome,http_status,error_code) (rate(gateway_api_calls_total{app=~\"$app\",instance=~\"$instance\",api=~\"$api\",stream=~\"$stream\",job=~\"gateway|admin\"}[$__rate_interval])))",
          "legendFormat": "全量请求"
        },
        {
          "refId": "B",
          "expr": "sum(max by(app,source,api,stream,outcome,http_status,error_code) (rate(gateway_api_calls_total{app=~\"$app\",instance=~\"$instance\",api=~\"$api\",stream=~\"$stream\",job=~\"gateway|admin\",stream=\"false\"}[$__rate_interval])))",
          "legendFormat": "非流式"
        },
        {
          "refId": "C",
          "expr": "sum(max by(app,source,api,stream,outcome,http_status,error_code) (rate(gateway_api_calls_total{app=~\"$app\",instance=~\"$instance\",api=~\"$api\",stream=~\"$stream\",job=~\"gateway|admin\",stream=\"true\"}[$__rate_interval])))",
          "legendFormat": "流式"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "N/A",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "请求成功率",
      "description": "保护性拒绝仍属于全量分母；SSE 业务错误按实际结束结果计失败。模型筛选不改变请求分母。无流量显示 N/A。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(max by(app,source,api,stream,outcome,http_status,error_code) (rate(gateway_api_calls_total{app=~\"$app\",instance=~\"$instance\",api=~\"$api\",stream=~\"$stream\",job=~\"gateway|admin\",outcome=\"success\"}[$__rate_interval]))) or vector(0))/sum(max by(app,source,api,stream,outcome,http_status,error_code) (rate(gateway_api_calls_total{app=~\"$app\",instance=~\"$instance\",api=~\"$api\",stream=~\"$stream\",job=~\"gateway|admin\"}[$__rate_interval])))",
          "legendFormat": "成功 / 全量"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "noValue": "N/A",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12
          },
          "min": 0,
          "max": 1
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Token 消耗 / 秒：输入、输出、总量",
      "description": "实际 attempt 用量；重试、embedding 独立计入。estimated 与 reported 分开；cached_input 是 input 子集，不再叠加到总量。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(kind,quality) (rate(gateway_tokens_total{app=~\"$app\",model=~\"$model\",instance=~\"$instance\",kind=~\"input|output\"}[$__rate_interval]))",
          "legendFormat": "{{kind}} / {{quality}}"
        },
        {
          "refId": "B",
          "expr": "sum by(quality) (rate(gateway_tokens_total{app=~\"$app\",model=~\"$model\",instance=~\"$instance\",kind=~\"input|output\"}[$__rate_interval]))",
          "legendFormat": "总量 / {{quality}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "N/A",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "请求平均 RT / ms",
      "description": "包含缓存命中、流式完整响应及早期拒绝；按实例/应用/API/流式筛选。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(gateway_api_seconds_sum{app=~\"$app\",instance=~\"$instance\",api=~\"$api\",stream=~\"$stream\",job=~\"gateway|admin\"}[$__rate_interval]))/(sum(rate(gateway_api_seconds_count{app=~\"$app\",instance=~\"$instance\",api=~\"$api\",stream=~\"$stream\",job=~\"gateway|admin\"}[$__rate_interval])))*1000",
          "legendFormat": "整体请求"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "noValue": "N/A",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "请求 P95 / P99 RT",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le)(rate(gateway_api_seconds_bucket{app=~\"$app\",instance=~\"$instance\",api=~\"$api\",stream=~\"$stream\",job=~\"gateway|admin\"}[$__rate_interval])))*1000",
          "legendFormat": "0.95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99,sum by(le)(rate(gateway_api_seconds_bucket{app=~\"$app\",instance=~\"$instance\",api=~\"$api\",stream=~\"$stream\",job=~\"gateway|admin\"}[$__rate_interval])))*1000",
          "legendFormat": "0.99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "noValue": "N/A",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "模型 attempt：成功与失败 / 秒",
      "description": "实际付费尝试分母；不包含 prepared 取消，不等于客户端请求成功率。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(model,status,quality)(rate(gateway_attempts_total{app=~\"$app\",model=~\"$model\",instance=~\"$instance\"}[$__rate_interval]))",
          "legendFormat": "{{model}} / {{status}} / {{quality}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "noValue": "N/A",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "首 Token P95 / P99",
      "description": "从 attempt 开始到首次转发，包含准入开销；未转发事件无样本。模型指标不支持 API 筛选。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95,sum by(le,model)(rate(gateway_first_token_seconds_bucket{app=~\"$app\",model=~\"$model\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "{{model}} / 0.95"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.99,sum by(le,model)(rate(gateway_first_token_seconds_bucket{app=~\"$app\",model=~\"$model\",instance=~\"$instance\"}[$__rate_interval])))",
          "legendFormat": "{{model}} / 0.99"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "N/A",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 28,
      "type": "timeseries",
      "title": "用量报告的费用 / 秒",
      "description": "请求观测值，非结算账本；修正不通过重跑模型产生此指标，财务金额以账本为准。",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(quality)(rate(gateway_cost_micro_total{app=~\"$app\",model=~\"$model\",instance=~\"$instance\"}[$__rate_interval]))/1000000",
          "legendFormat": "{{quality}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyCNY",
          "noValue": "N/A",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 12
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    }
  ],
  "uid": "gateway-applications",
  "timezone": "browser",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "editable": false,
  "title": "应用与错误码监控",
  "templating": {
    "list": [
      {
        "name": "instance",
        "label": "网关实例",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(gateway_api_calls_total, instance)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "app",
        "label": "应用名称 / ID",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(gateway_app_info, app)",
        "refresh": 1,
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "api",
        "label": "API",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(gateway_api_calls_total, api)",
        "refresh": 1,
        "includeAll": true,

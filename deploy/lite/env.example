# 复制到项目根目录 .env，仅用于独立的 lite 项目，不覆盖已有部署凭据。
GW_IMAGE=llm-gateway:lite
GW_EDGE_IMAGE=caddy:2.10
GW_API_HOST=api.example.com
GW_CONSOLE_HOST=console.example.com
# 备案前 local 入口；公开上线前改为 https://console.你的域名。
GW_ADMIN_ORIGIN=https://localhost:8443
GW_ADMIN_USER=admin
GW_ADMIN_PASSWORD=CHANGE_ME_12_TO_72_BYTES
GW_MASTER_KEY=CHANGE_ME_BASE64_32_BYTES
# 建议使用 32 位随机十六进制密码，避免 DSN/URL 转义问题。
GW_LOCAL_DB_PASSWORD=CHANGE_ME_HEX
GW_LOCAL_ROOT_PASSWORD=CHANGE_ME_HEX
GW_LOCAL_REDIS_PASSWORD=CHANGE_ME_HEX
GW_CACHE_ENABLED=false
GW_MYSQL_MAX_OPEN_CONNS=12
GW_MYSQL_MAX_IDLE_CONNS=2
GW_REDIS_POOL_SIZE=8
GW_KAFKA_TOPIC=gateway-events
GW_KAFKA_GROUP=gateway-metering
GW_ETCD_PREFIX=/llm-gateway
GW_OUTBOX_GLOBAL_BYTES=536870912
GW_OUTBOX_APP_BYTES=67108864
GW_LITE_LOCAL_PORT=8443
